# Copy to .env and fill in locally. Never commit real values.
# Directory for /api/generate silhouette outputs (default: <tmp>/3d-maker-output)
MAKER_OUTPUT=
# Path to a Blender LTS binary for headless import checks (optional)
BLENDER_BIN=
# Directory for the SQLite database and stored objects (default: ./var)
MAKER_DATA=
# HMAC key for signed download URLs. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# If empty, a random key is used and links stop working after a restart.
MAKER_SECRET_KEY=
# Optional single-owner bearer token required on /api/v1 (until real auth, P4-01)
MAKER_API_TOKEN=
# Worker credentials for the internal API: "<worker-id>:<token>,..." (tokens 16+ chars)
MAKER_WORKER_TOKENS=
